# GitHub Actions self-hosted runner — environment configuration.
# Copy to `.env` (make setup does this for you) and fill in the values.
# `.env` is gitignored — NEVER commit a real token.

# ── Registration ──────────────────────────────────────────────────────────

# GitHub Personal Access Token used by the runner entrypoint to mint a
# short-lived registration token via the GitHub API and register itself.
# Pull this from your secret manager — do not paste a real token into this
# template, and never commit the resulting `.env`.
#
# Required scopes:
#   - RUNNER_SCOPE=repo → classic PAT with `repo` scope (or a fine-grained PAT
#     with "Administration: Read & write" on the target repo)
#   - RUNNER_SCOPE=org  → classic PAT with `admin:org` scope (needed to mint
#     org-level runner registration tokens)
ACCESS_TOKEN=

# REQUIRED — pick one target. `RUNNER_SCOPE` and its matching variable are a
# pair: set both, or registration fails on startup.
#
#   repo scope -> RUNNER_SCOPE=repo  + REPO_URL
#   org  scope -> RUNNER_SCOPE=org   + ORG_NAME
#
# Uncomment exactly one block below.

RUNNER_SCOPE=repo
REPO_URL=https://github.com/<owner>/<repo>

# RUNNER_SCOPE=org
# ORG_NAME=<org>

# ── Identity / labels ────────────────────────────────────────────────────

# Runner display name (shown in Settings → Actions → Runners).
# Leave UNSET if you scale to RUNNER_COUNT > 1 (see Makefile) — each replica
# then falls back to its container hostname, keeping names unique. Set it
# only when running a single, named runner instance.
RUNNER_NAME=gh-runner-r1

# Comma-separated labels. These must match what your workflows already put in
# `runs-on:` — a mismatch is SILENT, the runner registers fine and jobs simply
# queue forever waiting for a runner that never matches. Check an existing
# workflow before changing this.
LABELS=self-hosted,linux,x64,dind

# ── Behavior ──────────────────────────────────────────────────────────────

# true  = deregister + destroy the runner container after each job (clean-room
#         jobs, no state leak between runs — the container needs an external
#         restart policy/orchestrator to come back for the next job).
# false = persistent, always-on runner process. Matches the Forgejo side,
#         which runs `forgejo-runner daemon` as a long-lived process.
EPHEMERAL=false

# Keep the runner binary version pinned to what's baked into the image
# instead of self-updating at runtime.
DISABLE_AUTO_UPDATE=true

# ── Scaling (optional) ───────────────────────────────────────────────────

# Forgejo's single runner handles 2 concurrent jobs via `runner.capacity: 2`
# in config.yaml (one process, N job slots). The GitHub Actions runner has no
# such internal concurrency knob — one container == one job at a time — so the
# equivalent here is running multiple runner containers. `make start
# RUNNER_COUNT=2` scales the `runner` service to N replicas via
# `docker compose up --scale`. Leave RUNNER_NAME unset above when using this.
RUNNER_COUNT=1
